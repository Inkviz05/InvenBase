#!/bin/sh

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File scripts/check-secrets.ps1 -Staged
fi

if command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -File scripts/check-secrets.ps1 -Staged
fi

echo "Secret check requires PowerShell (pwsh or powershell.exe)." >&2
exit 1
